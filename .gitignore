# ============================================================
# Vivado generated files/directories
# Keep source files and project files, ignore regenerated output
# ============================================================

# Vivado cache / generated output
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.sim/
*.runs/

# Vivado temporary / journal / log files
*.jou
*.log
*.str
*.dmp
*.pb

# XSim generated files
xsim.dir/
*.wdb
*.wcfg

# Generated IP / simulation artifacts
.ipynb_checkpoints/
.Xil/
.webtalk/
*.html
*.xml
*.zip

# Common Vivado generated reports/output
*.rpt
*.rpx
*.bit
*.bin
*.ltx

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Backup / temporary files
*~
*.bak
*.tmp
